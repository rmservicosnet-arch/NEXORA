# ---------------------------------------------------------------------------
# Copie para .env e preencha. O .env NÃO é versionado.
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- Banco de dados --------------------------------------------------------
#
# DOIS usuários, de propósito. Ver docs/TENANCY.md §2, camada 3.
#
#   estoque_app       usuário da aplicação. NÃO é dono das tabelas e NÃO tem
#                     BYPASSRLS. É o que faz o Row-Level Security valer.
#   estoque_migrator  usuário das migrações. Dono das tabelas.
#
# Usar o mesmo usuário nos dois desliga silenciosamente o RLS — o dono da
# tabela ignora a policy a menos que ela tenha FORCE, e migração precisa de
# privilégio que a aplicação não pode ter.
#
# `npm run db:setup` cria banco e usuários a partir de POSTGRES_SUPERUSER_URL.

DATABASE_URL="postgresql://estoque_app:TROQUE_ESTA_SENHA@localhost:5432/estoque?schema=public"
DIRECT_URL="postgresql://estoque_migrator:TROQUE_ESTA_SENHA@localhost:5432/estoque?schema=public"

# Conexões do pool por processo. Padrão: 10 (4 sob NODE_ENV=test).
# Sete arquivos de teste em paralelo, cada um subindo a aplicação, pedem 70
# conexões de um PostgreSQL que aceita 100 — e a suíte falha com ECONNABORTED
# num teste aleatório, sem relação com o que ele testa.
# DATABASE_POOL_MAX=10

# Usado apenas por `npm run db:setup`, uma vez. Não é lido pela aplicação.
POSTGRES_SUPERUSER_URL="postgresql://postgres:SUA_SENHA_DO_POSTGRES@localhost:5432/postgres"

# --- Autenticação ----------------------------------------------------------
#
# Gere cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Os dois domínios de autenticação (ADR-009) usam segredos DIFERENTES.
# Segredo compartilhado permitiria forjar um token de funcionário a partir de
# um de cliente trocando a claim `aud`.

JWT_FUNCIONARIO_SECRET=""
JWT_CLIENTE_SECRET=""
JWT_ACCESS_TTL_SEGUNDOS="900"
REFRESH_TOKEN_TTL_DIAS="30"

# --- Aplicação -------------------------------------------------------------
NODE_ENV="development"
API_PORT="3333"
API_PREFIX="api"
WEB_ORIGIN="http://localhost:5173"
LOG_LEVEL="debug"

# Cookies de refresh: em produção exige HTTPS.
COOKIE_SECURE="false"
COOKIE_DOMAIN="localhost"

# --- Limites ---------------------------------------------------------------
RATE_LIMIT_JANELA_SEGUNDOS="60"
RATE_LIMIT_MAX="120"
RATE_LIMIT_LOGIN_MAX="8"

# --- Armazenamento de imagens (Fase 2) -------------------------------------
# Ver docs/MEDIA.md. Em desenvolvimento usa o disco local.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.storage"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION=""
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""

# --- Notificações push (Fase 4) --------------------------------------------
# Ver docs/NOTIFICATIONS.md. Vazio = envio desligado, fila só registra.
EXPO_ACCESS_TOKEN=""
