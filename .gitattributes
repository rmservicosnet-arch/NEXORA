# Fim de linha LF em todo lugar — no repositório e na cópia de trabalho.
#
# É o mesmo que o .editorconfig determina. Sem isto, o Windows converteria
# para CRLF na cópia local e cada máquina veria o arquivo inteiro como
# alterado, o que torna `git diff` inútil numa equipe mista.
* text=auto eol=lf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Gerado por ferramenta: não conta como código na revisão.
package-lock.json linguist-generated=true -diff
packages/db/prisma/migrations/** linguist-generated=true
