# Versões exatas, sem intervalo.
#
# Motivo registrado: em 19/09/2026 a tag `latest` do pacote `prisma` apontava
# para 8.0.0-rc.15 (release candidate) enquanto `@prisma/client` estável era
# 7.10.0. Um `^` teria instalado um par CLI/client incompatível.
#
# Num sistema com estoque, custo médio e financeiro, atualização de dependência
# é decisão deliberada — nunca efeito colateral de `npm install`.
save-exact=true
engine-strict=true
