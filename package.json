{
  "name": "estoque",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de estoque, PDV, catálogo, pedidos e financeiro",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @estoque/api\" \"npm run dev -w @estoque/web\"",
    "build": "npm run build -w @estoque/contracts && npm run build -w @estoque/core && npm run build -w @estoque/db && npm run build -w @estoque/api && npm run build -w @estoque/web",
    "typecheck": "tsc -b --pretty && npm run typecheck:tests && npm run typecheck -w @estoque/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @estoque/db",
    "db:migrate": "npm run migrate -w @estoque/db",
    "db:deploy": "npm run deploy -w @estoque/db",
    "db:studio": "npm run studio -w @estoque/db",
    "db:seed": "npm run seed -w @estoque/db",
    "db:reset": "npm run reset -w @estoque/db",
    "db:setup": "dotenv -e .env -- tsx scripts/setup-database.ts",
    "db:setup:ci": "tsx scripts/setup-database.ts",
    "db:deploy:ci": "npm run deploy:ci -w @estoque/db",
    "db:seed:ci": "npm run seed:ci -w @estoque/db",
    "db:generate:ci": "npm run generate:ci -w @estoque/db",
    "db:verificar": "dotenv -e .env -- tsx scripts/verificar-banco.ts",
    "db:sync-perfis": "dotenv -e .env -- tsx scripts/sincronizar-perfis.ts",
    "plataforma:admin": "dotenv -e .env -- tsx scripts/criar-admin-plataforma.ts",
    "expirar": "dotenv -e .env -- tsx scripts/expirar.ts",
    "corrigir:troco": "dotenv -e .env -- tsx scripts/corrigir-troco.ts",
    "expirar:ci": "tsx scripts/expirar.ts",
    "db:sync-perfis:ci": "tsx scripts/sincronizar-perfis.ts",
    "typecheck:tests": "tsc -p apps/api/tsconfig.test.json --pretty && tsc -p packages/core/tsconfig.test.json --pretty && tsc -p packages/db/tsconfig.test.json --pretty && tsc -p packages/contracts/tsconfig.test.json --pretty"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "dotenv-cli": "11.0.0",
    "pg": "8.23.0",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
