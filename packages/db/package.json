{
  "name": "@estoque/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema, migrações e cliente Prisma com escopo de tenant",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "generate:ci": "prisma generate",
    "deploy:ci": "prisma migrate deploy",
    "seed:ci": "tsx prisma/seed.ts",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "reset": "dotenv -e ../../.env -- prisma migrate reset",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "format": "dotenv -e ../../.env -- prisma format",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "build": "tsc -b"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "decimal.js": "10.6.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@estoque/core": "*",
    "dotenv-cli": "11.0.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
