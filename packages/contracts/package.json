{
  "name": "@estoque/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Schemas Zod e tipos compartilhados entre API, web e mobile",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc -p tsconfig.esm.json && node ./pos-build.mjs",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
