{
  // Os testes NAO entram no build: eles emitiriam para dist. Mas ficar de
  // fora do build virou ficar de fora da CONFERENCIA — `npm run typecheck`
  // dizia "limpo" com um arquivo de teste que nao compilava, e o erro so
  // aparecia ao rodar.
  //
  // Este projeto so confere, nao emite.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "dist-types", "node_modules"]
}
